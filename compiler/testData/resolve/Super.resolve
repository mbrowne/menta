~T~interface T {
    fun foo() {}
}
~C~open define C() {
    fun bar() {}
}

~A~define A<E>() : C(), T {

    fun test() {
        `T`super<T>.foo()
        `C`super<C>.bar()
        `T`super<T>@A.foo()
        `C`super<C>@A.bar()
    }

    inner define B : T {
        fun test() {
            `T`super<T>.foo();
            `C`super<C>@A.bar()
            `T`super<T>@A.foo()
            `T`super<T>@B.foo()
            `T`super.foo()
        }
    }
}

~G~interface G<T> {
    fun foo() {}
}

define CG : G<Int> {
    fun test() {
        `G`super<`G`G>.foo() // OK
    }
}