fun Int.foo() {}

open define A {
   ~A.foo~fun foo(i: Int) {}
}
open define B {}

fun test(a: A, b: B) {
    with (a) {
        with (b) {
            // resolved to A.foo with error: CONSTANT_EXPECTED_TYPE_MISMATCH
            foo(1.0)
        }
    }
}

fun <T, R> with(receiver: T, f: T.() -> R) : R = receiver.f()