== test ==
fun test() {
    val x: Int

    if (getBoolean())
        myRun {
            while (getBoolean()) {
                do {
                    myRun {
                        if (getBoolean()) {
                            x = 42
                        }
                        else {
                            x = 43
                        }
                    }
                    break
                } while (getBoolean())
                myRun { x.inc() }
                myRun { x = 42 }
                break
            }
            x = 42
        }
    else
        myRun {
            x = 42
        }

    x.inc()
}
