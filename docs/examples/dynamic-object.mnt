import menta.dynamic.*

define dynamic ProductRepository() {
    public override fun tryInvokeMember(binder: InvokeMemberBinder, args: Array<out Any?>) {
        val fieldName = binder.name.removePrefix("findBy").replaceFirstChar { it.lowercase() }
        return findBy(fieldName, args[0])
    }

    fun findBy(fieldName: String, value: Any?) {
        println("called findBy with '$fieldName' and '$value'")
    }
}

fun main() {
    val productRepository = ProductRepository()
    val sku = productRepository.findBySku("abc123")
}

/*
Compiler architecture that supports this feature:

Source: define dynamic ProductRepository() { ... }
  │
  ▼ Parser
PSI: KtDefine [DEFINE_KEYWORD, DYNAMIC_KEYWORD, IDENTIFIER("ProductRepository"), ...]
  │
  ▼ FIR Builder
FIR: FirRegularClass with supertype menta.dynamic.DynamicObject
  │
  ▼ FIR Resolution (scope)
FirMentaDynamicScope wraps class scope → synthetic members for any name
  │
  ▼ FIR-to-IR (CallAndReferenceGenerator)
IR: IrCall(tryInvokeMember) with IrConstructorCall(InvokeMemberBinder("findBySku")) and IrVararg(args)
  │
  ▼ JVM Code Generator
Bytecode: invokevirtual DynamicObject.tryInvokeMember(InvokeMemberBinder, Object[])
*/
