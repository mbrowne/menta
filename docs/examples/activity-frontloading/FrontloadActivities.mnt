/*
 * Activity Planning: Frontload Activities
 *
 * This example shows an algorithm that's part of a larger example.
 * Use case: http://mbrowne.github.io/prokon-dci/#/use-cases/frontload-activities
 */
fun FrontloadActivities(project: Project): Plan {
    val activities = project.activities
    return activities.plan()


    role project requires PlannableProject
    
    role activities {
        public fun plan(): Plan {
            // val alreadyPlanned = setOf<PlannableActivity>()

            return activities
                .map {
                    object {
                        public val activity = it

                        // Return a partially applied function with the start time that will
                        // return an ActivityTiming object when called again
                        public fun updateActivityTiming() {
                            return { startTime: LocalDateTime -> ActivityTiming(it, startTime) }
                        }
                    }
                }
                .fold(listOf<ActivityTiming>(), planActivity)
        }  
    } requires List<PlannableActivity>

    fun planActivity(
        plannedActivities: List<ActivityTiming>,
        currentActivityPlanningState: Any // TODO
    ) {
        val (activity, updateActivityTiming) = currentActivityPlanningState
        // updateActivityTiming()

        /*
        var startTime = activityTiming.startTime
        val dependencies = activity.map {
            val currentDepStartTime = startTime + it.duration
            startTime = currentDepStartTime
            ActivityTiming(it, startTime)
        }
        */

        if (!alreadyPlanned.contains(activity)) {
            return plannedActivities
        }

        val planned = activity.plan()
        alreadyPlanned.add(activity)
        return plannedActivities + planned


        role plannedActivities requires List<ActivityTiming>

        role activity {
            public fun plan(): ActivityTiming {
                return ActivityTiming(this, dependencies.getEarliestStartTime())
            }
        } requires PlannableActivity

        role dependencies {
            public fun getEarliestStartTime(): LocalDateTime {
                return maxByOrNull<ActivityTiming, LocalDateTime> {
                    it.startTime
                }?.finishTime ?: project.startTime
            }
        } requires List<ActivityTiming>
    }
}