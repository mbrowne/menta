import java.time.LocalDateTime

interface PlannableProject {
    public val startTime: LocalDateTime
    public val activities: List<Activity>
}

interface PlannableActivity {
    public val name: String
    public val duration: Int
    public val dependencies: List<PlannableActivity>
}

interface ActivityFinishTimingTrait {
    public val activity: PlannableActivity
    public val startTime?: LocalDateTime
    public val finishTime get = { if (startTime) { startTime + duration } else null }
}

define MaybeActivityTiming(
    public val activity: PlannableActivity, public val startTime?: LocalDateTime
): ActivityFinishTimingTrait {
    // public val finishTime get = { startTime + duration }
    public val isPlanned get = { startTime != null }
}

define ActivityTiming(
    public val activity: PlannableActivity, public val startTime: LocalDateTime
): ActivityFinishTimingTrait {}

